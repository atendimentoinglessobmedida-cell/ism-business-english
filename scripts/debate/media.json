    "humanReviewed": false
  },
  {
    "app": "business",
    "unitId": "ethical-decisions",
    "kind": "turn",
    "turn": 12,
    "speaker": "Morgan",
    "voice": "af_nicole",
    "text": "Let us recommend postponement unless an independent review confirms that the limited trial is justified.",
