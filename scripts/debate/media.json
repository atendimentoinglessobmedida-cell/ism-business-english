  {
    "app": "business",
    "unitId": "ethical-decisions",
    "kind": "turn",
    "turn": 0,
    "speaker": "Morgan",
    "voice": "af_nicole",
    "text": "The launch is tomorrow, but the supplier has not completed one important check.",
